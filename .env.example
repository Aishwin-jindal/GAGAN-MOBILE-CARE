# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
# Supports any PostgreSQL connection string (Neon, Supabase, Render, Railway, AWS RDS, or local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gagan_mobile_care

# Or individual PostgreSQL variables
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=gagan_mobile_care

# Backend API server port
PORT=5000

# ==========================================
# OPTIONAL EMAIL OTP CONFIGURATION (Gmail / SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

GMAIL_USER=
GMAIL_APP_PASSWORD=
